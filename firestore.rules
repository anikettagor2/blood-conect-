
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
    }

    // Donors collection
    match /donors/{donorId} {
      allow read: if isAdmin(); // Only admins can see full donor list? Or maybe public stats?
      // Public needs to query donors? No, "Notify matching donors" happens via backend usually.
      // But Admin Panel lists registered donors.
      // Modifying: Donors can edit only their own data.
      allow create: if isAuthenticated() && request.auth.uid == donorId;
      allow update: if isOwner(donorId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Banks collection
    match /bloodBanks/{bankId} {
      allow read: if true; // Public can view stock
      allow write: if isAdmin(); // Only admin updates stock
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if true; // Public can view campaigns
      allow create: if isAuthenticated(); // Registered users can organize? Or just admins?
      // "Campagin Registration" implies users can register campaigns.
      // Let's allow authenticated users to create.
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.organizerId == request.auth.uid);
    }

    // Emergency Requests
    match /requests/{requestId} {
      allow read: if isAuthenticated(); // Donors/Admins can see requests
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
    }
  }
}
